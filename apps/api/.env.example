# 本文件用于宿主机开发；Docker Compose 会自行注入 postgres / redis 服务名，
# 因此 `docker compose up --build` 不依赖本地 apps/api/.env 文件。
# 数据库连接
# 注意：Windows 下 Prisma schema-engine 可能将 localhost 解析为 IPv6 ::1，
# 而 Docker 端口映射仅监听 IPv4，导致 P1001 连接失败，故显式使用 127.0.0.1。
DATABASE_URL=postgresql://helio:helio@127.0.0.1:5432/helio
REDIS_URL=redis://localhost:6379
# Redis 连接（worker 使用，也可用 REDIS_URL 由 ioredis 解析）
REDIS_HOST=localhost
REDIS_PORT=6379

# 服务端口
PORT=3000

# JWT（生产环境务必替换为强随机值）
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 支付网关主链路：mock | wechat | alipay（默认 mock；切换真实渠道前须配置下方对应凭据）
PAYMENT_PROVIDER=mock
# 仅非生产环境显式启用 Mock 支付成功回调演示；默认 false，生产环境始终禁用
MOCK_PAYMENT_DEMO_ENABLED=false
# 影子调用（暗发布）：true 时真实渠道与 Mock 并行执行、以 Mock 为准，差异记日志
PAYMENT_SHADOW=false
# 影子渠道：wechat | alipay
PAYMENT_SHADOW_PROVIDER=wechat

# 支付超时关单窗口（毫秒，默认 30 分钟，见 PaymentService）
PAYMENT_TIMEOUT_MS=1800000

# 日对账：worker/API 共同使用的 HMAC 密钥（生产环境必须使用密钥管理服务注入）
INTERNAL_REQUEST_SECRET=change-me-for-local-development
# worker 调用 api 的基地址（worker 进程读取，用于触发每日对账）
API_BASE_URL=http://localhost:3000/api

# 微信支付（Mock 阶段可留空；切换 PAYMENT_PROVIDER=wechat 前须配置下列凭据）
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
# 商户 API 私钥（PEM 内容，含 -----BEGIN/END----- 行）
WECHAT_PRIVATE_KEY=

# 支付宝（Mock 阶段可留空；切换 PAYMENT_PROVIDER=alipay 前须配置下列凭据）
ALIPAY_APP_ID=
# 应用私钥（PEM 内容，含 -----BEGIN/END----- 行）
ALIPAY_APP_PRIVATE_KEY=

# 前端地址（支付回调 return_url 用）
FRONTEND_URL=http://localhost:5173

# 回调公网地址（开发用内网穿透）
WEBHOOK_BASE_URL=
