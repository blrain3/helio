# 数据库连接
# 注意：Windows 下 Prisma schema-engine 可能将 localhost 解析为 IPv6 ::1，
# 而 Docker 端口映射仅监听 IPv4，导致 P1001 连接失败，故显式使用 127.0.0.1。
DATABASE_URL=postgresql://helio:helio@127.0.0.1:5432/helio
REDIS_URL=redis://localhost:6379
# Redis 连接（worker 使用，也可用 REDIS_URL 由 ioredis 解析）
REDIS_HOST=localhost
REDIS_PORT=6379

# 服务端口
PORT=3000

# JWT（生产环境务必替换为强随机值）
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 支付网关：mock | wechat | alipay（按渠道可独立配置，见下）
PAYMENT_GATEWAY=mock
PAYMENT_WECHAT_GATEWAY=mock
PAYMENT_ALIPAY_GATEWAY=mock

# 支付超时关单窗口（毫秒，默认 30 分钟，见 PaymentService）
PAYMENT_TIMEOUT_MS=1800000

# 日对账：worker 定时调用 api 内部对账端点时使用的内部令牌（api/worker 两进程需一致）
RECONCILE_INTERNAL_TOKEN=helio-internal
# worker 调用 api 的基地址（worker 进程读取，用于触发每日对账）
API_BASE_URL=http://localhost:3000

# 微信支付（Mock 阶段可留空）
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=

# 支付宝（Mock 阶段可留空）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=

# 前端地址（支付回调 return_url 用）
FRONTEND_URL=http://localhost:5173

# 回调公网地址（开发用内网穿透）
WEBHOOK_BASE_URL=
