{
  "name": "helio",
  "version": "1.0.0",
  "private": true,
  "description": "Helio — 太阳能能源监控平台",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "pretest": "pnpm run prisma:generate",
    "pretypecheck": "pnpm run prisma:generate",
    "postinstall": "pnpm run prisma:generate",
    "prisma:generate": "pnpm --filter @helio/api prisma:generate",
    "contracts:generate": "pnpm --filter @helio/api-client generate",
    "contracts:check": "pnpm run contracts:generate && git diff --exit-code -- apps/api/openapi.json packages/api-client/src/schema.d.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
